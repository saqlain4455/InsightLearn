{
  "name": "router-project",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@reduxjs/toolkit": "^2.10.1",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "@vitejs/plugin-react": "^5.1.0",
    "axios": "^1.13.2",
    "concurrently": "^9.2.1",
    "google-auth-library": "^10.5.0",
    "lucide-react": "^0.553.0",
    "nodemon": "^3.1.10",
    "react": "^18.3.1",
